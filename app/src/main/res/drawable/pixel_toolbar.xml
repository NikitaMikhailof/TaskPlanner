<?xml version="1.0" encoding="utf-8"?>
<!-- Тулбар: чёрный с зелёной полосой снизу -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/green" />
        </shape>
    </item>
</layer-list>
